{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.elasticemail/mcp",
  "title": "Elastic Email MCP Server",
  "description": "Send emails and manage contacts, lists, segments, templates and campaigns in Elastic Email.",
  "version": "1.0.0",
  "websiteUrl": "https://elasticemail.com/email-marketing-mcp",
  "repository": {
    "url": "https://github.com/ElasticEmail/elasticemail-mcp-server",
    "source": "github",
    "id": "1086493876"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/ElasticEmail/elasticemail-mcp-server/master/.github/ee-logo.png",
      "mimeType": "image/png",
      "sizes": ["400x400"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.elasticemail.com",
      "headers": [
        {
          "name": "X-Auth-Token",
          "description": "Your Elastic Email API key (Settings > Manage API Keys).",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
